{
  "name": "@adenyrr/astro-ui",
  "version": "1.2.0",
  "description": "Shared Astro workstation interface for adenyrr.me",
  "type": "module",
  "scripts": {
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\" \"playground/**/*.{css,astro}\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:a11y": "npm run build:playground && playwright test",
    "test:tokens": "node scripts/check-contrast.mjs",
    "dev": "astro dev --root \"$INIT_CWD/playground\"",
    "build:playground": "astro build --root playground",
    "preview:playground": "node scripts/serve-playground.mjs",
    "verify": "npm run format && npm run lint && npm run check && npm run test && npm run test:tokens"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/global.css",
    "./Header.astro": "./src/components/Header.astro",
    "./Footer.astro": "./src/components/Footer.astro",
    "./ThemeToggle.astro": "./src/components/ThemeToggle.astro",
    "./ThemeScript.astro": "./src/components/ThemeScript.astro",
    "./ReadingModeToggle.astro": "./src/components/ReadingModeToggle.astro",
    "./AmbientBackground.astro": "./src/components/AmbientBackground.astro",
    "./Animations.astro": "./src/components/Animations.astro"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inclusive-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@lucide/astro": "^1.33.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.2.4",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^16.4.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://forge.massivedynamics.be/aboutme/astro-ui.git"
  },
  "homepage": "https://forge.massivedynamics.be/aboutme/astro-ui",
  "bugs": {
    "url": "https://forge.massivedynamics.be/aboutme/astro-ui/-/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
