{
  "name": "@adenyrr/astro-sovereign-tty",
  "version": "2.1.2",
  "description": "Accessible sovereign terminal-style UI components and themes for Astro",
  "type": "module",
  "scripts": {
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\" \"playground/**/*.{css,astro}\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:a11y": "npm run build:playground && playwright test",
    "test:tokens": "node scripts/check-contrast.mjs",
    "test:fonts": "node scripts/check-fonts.mjs",
    "test:performance": "node scripts/run-lighthouse.mjs",
    "test:package": "node scripts/check-package.mjs",
    "dev": "astro dev --root \"$INIT_CWD/playground\"",
    "build:playground": "astro build --root playground",
    "preview:playground": "node scripts/serve-playground.mjs",
    "verify": "npm run format && npm run lint && npm run check && npm run test && npm run test:tokens"
  },
  "files": [
    "src",
    "docs",
    "SECURITY.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n.ts",
    "./safe-href": "./src/utils/safe-href.ts",
    "./navigation": "./src/utils/navigation.ts",
    "./styles.css": "./src/styles/styles.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./components.css": "./src/styles/components.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./compat.css": "./src/styles/compat.css",
    "./print.css": "./src/styles/print.css",
    "./themes/adenyrr.css": "./src/styles/themes/adenyrr.css",
    "./themes/docu.css": "./src/styles/themes/docu.css",
    "./themes/train.css": "./src/styles/themes/train.css",
    "./Header.astro": "./src/components/Header.astro",
    "./Footer.astro": "./src/components/Footer.astro",
    "./ThemeToggle.astro": "./src/components/ThemeToggle.astro",
    "./ThemeScript.astro": "./src/components/ThemeScript.astro",
    "./Fonts.astro": "./src/components/Fonts.astro",
    "./ReadingModeToggle.astro": "./src/components/ReadingModeToggle.astro",
    "./AmbientBackground.astro": "./src/components/AmbientBackground.astro",
    "./Animations.astro": "./src/components/Animations.astro"
  },
  "peerDependencies": {
    "astro": "^6.2.0 || ^7.0.0",
    "tailwindcss": "^4.1.18"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@lucide/astro": "^1.33.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "astro": "^7.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-astro": "1.7.0",
    "globals": "^16.4.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.2",
    "tailwindcss": "^4.1.18",
    "typescript-eslint": "8.55.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@typescript-eslint/scope-manager": "8.55.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adenyrr/astro-sovereign-tty.git"
  },
  "homepage": "https://github.com/adenyrr/astro-sovereign-tty#readme",
  "bugs": {
    "url": "https://github.com/adenyrr/astro-sovereign-tty/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
