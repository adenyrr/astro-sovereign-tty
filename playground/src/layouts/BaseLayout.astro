---
import { ClientRouter } from 'astro:transitions';
import Header from '../../../src/components/Header.astro';
import Footer from '../../../src/components/Footer.astro';
import AmbientBackground from '../../../src/components/AmbientBackground.astro';
import Animations from '../../../src/components/Animations.astro';
import ThemeScript from '../../../src/components/ThemeScript.astro';
import { chromeConfig } from '../config';
import '../../../src/styles/styles.css';

interface Props {
  title: string;
  router?: boolean;
  lang?: 'fr' | 'en';
  hideOnScroll?: boolean | 'mobile';
}

const { title, router = true, lang = 'fr', hideOnScroll } = Astro.props;
const config = {
  ...chromeConfig,
  locale: lang,
  header: {
    ...chromeConfig.header,
    ...(hideOnScroll === undefined ? {} : { hideOnScroll }),
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <ThemeScript />
    <meta name="color-scheme" content="light dark" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — astro-ui playground</title>
    {router && <ClientRouter />}
  </head>
  <body>
    <AmbientBackground />
    <Header config={config} currentPath={Astro.url.pathname} />
    <main id="main" tabindex="-1" class="page-content">
      <slot />
    </main>
    <Footer config={config} />
    <Animations />
  </body>
</html>
