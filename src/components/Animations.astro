<script>
  /**
   * Remaining JavaScript animation — GSAP and Lenis were removed:
   *  - smooth scrolling is native (html { scroll-behavior: smooth })
   *  - reveals are CSS scroll-driven animations (global.css)
   *  - the progress bar uses animation-timeline: scroll() (BaseLayout)
   * Only count-up remains for stat counters (.stat-value[data-target]); CSS
   * cannot implement it without typed attr(), which is still too new.
   */

  const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let observer: IntersectionObserver | null = null;

  function countUp(el: HTMLElement, target: number) {
    const small = el.querySelector('small');
    const duration = prefersReducedMotion() ? 0 : 1300;
    const start = performance.now();

    function frame(now: number) {
      const t = duration === 0 ? 1 : Math.min(1, (now - start) / duration);
      // ease-out quad
      const eased = 1 - (1 - t) * (1 - t);
      el.textContent = Math.round(eased * target).toString();
      if (small) el.appendChild(small);
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  function init() {
    observer?.disconnect();
    const counters = document.querySelectorAll<HTMLElement>('.stat-value[data-target]');
    if (!counters.length) return;

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          observer?.unobserve(el);
          const target = parseInt(el.dataset.target || '0', 10);
          if (target) countUp(el, target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );

    counters.forEach((el) => observer?.observe(el));
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
