---
import BrandIcon from './BrandIcon.astro';
import { ArrowUp, GitBranch, Mail, MessageCircle, Rss } from '@lucide/astro';
import type { SiteChromeConfig } from '../types';

interface Props {
  config: SiteChromeConfig;
}

const { config } = Astro.props;
const footer = config.footer || {};
const year = new Date().getFullYear();
const socials = (config.header?.socialLinks || []).filter((link) => link.enabled !== false);
const navigation = (config.header?.navigation || []).filter(
  (item) => item.enabled !== false && (!item.feature || config.features?.[item.feature]),
);
const brandIcons = new Set(['Github', 'Gitlab', 'Linkedin']);
const iconMap: Record<string, any> = { Mail, MessageCircle, Rss };
---

{
  footer.show && (
    <footer id="site-footer">
      <div class="footer-shell">
        <div class="footer-main">
          <div class="footer-signature">
            <p>
              <span aria-hidden="true">$</span> {footer.signatureCommand}
            </p>
            <a href={footer.authorUrl} class="footer-brand">
              .{footer.author}
            </a>
            <p class="footer-note">{footer.note}</p>
          </div>

          <nav class="footer-nav" aria-label="Navigation du pied de page">
            <p>{footer.navigationLabel}</p>
            {navigation.map((item) => (
              <a
                href={item.url || item.route}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                /{item.label}
              </a>
            ))}
          </nav>

          <div class="footer-connect">
            <p>{footer.connectLabel}</p>
            <div>
              {socials.map((link) => {
                const Icon = iconMap[link.icon];
                return brandIcons.has(link.icon) ? (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    title={link.label}
                  >
                    <BrandIcon name={link.icon as 'Github' | 'Gitlab' | 'Linkedin'} size={17} />
                  </a>
                ) : Icon ? (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    title={link.label}
                  >
                    <Icon size={17} />
                  </a>
                ) : null;
              })}
              {footer.rss && (
                <a
                  href={typeof footer.rss === 'string' ? footer.rss : '/rss.xml'}
                  aria-label="Flux RSS"
                  title="Flux RSS"
                >
                  <Rss size={17} />
                </a>
              )}
            </div>
          </div>

          <a href="#main" class="back-top" aria-label={footer.backToTopLabel}>
            <>
              <ArrowUp size={16} />
              <span>{footer.backToTopLabel}</span>
            </>
          </a>
        </div>

        <div class="footer-status">
          <span class="shell-prompt">
            <b aria-hidden="true">{footer.shellPrompt}</b>:~$ <i aria-hidden="true" />
          </span>
          <span class="branch">
            <GitBranch size={13} /> {footer.branch}{' '}
            <>
              <span class="sync-mark" aria-hidden="true" />
              <span class="sr-only">branche à jour</span>
            </>
          </span>
          <span class="build">
            {footer.poweredBy?.map((item, index) => (
              <>
                {index > 0 && ' · '}
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.label}
                </a>
              </>
            ))}
          </span>
          <span>
            {footer.copyright || 'Copyleft'} · {year}
          </span>
        </div>
      </div>
    </footer>
  )
}

<style>
  #site-footer {
    position: relative;
    z-index: 2;
    padding: 0 1rem 1rem;
  }
  .footer-shell {
    width: min(1180px, 100%);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    background: color-mix(in srgb, var(--glass-bg-strong) 88%, transparent);
    box-shadow: inset 0 1px var(--glint);
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1.35fr 0.6fr 0.65fr auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding: clamp(2rem, 5vw, 3.5rem);
  }
  .footer-signature > p:first-child,
  .footer-nav > p,
  .footer-connect > p {
    margin: 0 0 1rem;
    color: var(--text-muted);
    font: 600 0.65rem var(--font-code);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .footer-signature > p:first-child span {
    color: var(--accent-teal);
  }
  .footer-brand {
    display: inline-block;
    color: var(--text-primary);
    font: 750 clamp(2rem, 5vw, 3.2rem)/1 var(--font-body);
    letter-spacing: -0.06em;
    text-decoration: none;
  }
  .footer-brand::first-letter {
    color: var(--accent-amber);
  }
  .footer-note {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.65;
    white-space: pre-line;
  }
  .footer-nav {
    display: grid;
    align-content: start;
  }
  .footer-nav a {
    padding: 0.23rem 0;
    color: var(--text-secondary);
    font: 0.72rem var(--font-code);
    text-decoration: none;
  }
  .footer-nav a:hover {
    color: var(--accent-blue);
    transform: translateX(2px);
  }
  .footer-connect > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .footer-connect a,
  .back-top {
    display: grid;
    place-items: center;
    width: 39px;
    height: 39px;
    color: var(--text-muted);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    background: var(--glass-bg);
  }
  .footer-connect a:hover,
  .back-top:hover {
    color: var(--accent-blue);
    border-color: rgba(var(--blue-rgb), 0.45);
  }
  .back-top {
    width: auto;
    min-width: 42px;
    padding: 0 0.7rem;
    text-decoration: none;
  }
  .back-top span {
    display: none;
  }
  .footer-status {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 42px;
    padding: 0.5rem 1rem;
    color: var(--text-muted);
    border-top: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--bg-1) 80%, transparent);
    font: 0.62rem var(--font-code);
  }
  .shell-prompt {
    color: var(--text-secondary);
  }
  .shell-prompt b {
    color: var(--accent-teal);
    font-weight: 600;
  }
  .shell-prompt i {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.18rem;
    vertical-align: -0.15em;
    background: var(--accent-amber);
    animation: footer-cursor 1.1s steps(1) infinite;
  }
  .branch {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-blue);
  }
  .sync-mark {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-teal);
  }
  .build {
    margin-left: auto;
  }
  .build a {
    color: inherit;
    text-decoration: none;
  }
  .build a:hover {
    color: var(--accent-blue);
  }
  @keyframes footer-cursor {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 760px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
    }
    .footer-signature {
      grid-column: 1 / -1;
    }
    .back-top {
      justify-self: end;
      align-self: end;
    }
    .footer-status {
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
    .build {
      margin-left: 0;
    }
  }
  @media (max-width: 460px) {
    #site-footer {
      padding-inline: 0.6rem;
    }
    .footer-main {
      grid-template-columns: 1fr;
    }
    .footer-signature {
      grid-column: auto;
    }
    .back-top {
      justify-self: start;
    }
    .back-top span {
      display: inline;
      margin-left: 0.45rem;
      font: 0.66rem var(--font-code);
    }
    .shell-prompt {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shell-prompt i {
      animation: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .footer-shell {
      background: var(--bg-1);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
