---
import ThemeToggle from './ThemeToggle.astro';
import ReadingModeToggle from './ReadingModeToggle.astro';
import BrandIcon from './BrandIcon.astro';
import { ExternalLink, Menu, Terminal, X } from '@lucide/astro';
import type { NavigationItem, SiteChromeConfig } from '../types';

interface Props {
  config: SiteChromeConfig;
  currentPath?: string;
}

const { config, currentPath = Astro.url.pathname } = Astro.props;
const navItems = (config.header?.navigation || []).filter(
  (item) => item.enabled !== false && (!item.feature || config.features?.[item.feature]),
);
const socialLinks = (config.header?.socialLinks || []).filter((link) => link.enabled !== false);
const githubLink = socialLinks.find((link) => link.label.toLowerCase() === 'github');
const hideOnScroll = config.header.hideOnScroll ?? 'mobile';

function active(item: NavigationItem) {
  if (typeof item.active === 'boolean') return item.active;
  return (
    !item.external &&
    Boolean(item.route) &&
    (currentPath === item.route || (item.route !== '/' && currentPath.startsWith(item.route!)))
  );
}
---

{
  config.header.show && (
    <header
      id="site-header"
      data-scroll-state="visible"
      data-hide-on-scroll={
        hideOnScroll === false ? undefined : hideOnScroll === true ? 'all' : 'mobile'
      }
    >
      <a class="skip-link" href="#main">
        Aller au contenu principal
      </a>
      <div class="header-shell">
        <a
          class="brand"
          href={config.header.homeUrl || '/'}
          aria-label={`${config.header.brandName} — accueil`}
        >
          <span class="brand-glyph">
            <Terminal size={15} />
          </span>
          <>
            <span>{config.header.brandName}</span>
            <span class="brand-host">{config.header.brandHost}</span>
          </>
        </a>

        <nav class="desktop-nav" aria-label="Navigation principale">
          {navItems.map((item) => {
            const href = item.url || item.route;
            const isActive = active(item);
            return (
              <a
                href={href}
                class:list={['nav-item', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                <span aria-hidden="true">~/</span>
                {item.label}
                {item.external && <ExternalLink size={10} />}
              </a>
            );
          })}
        </nav>

        <div class="header-actions">
          {githubLink && (
            <a
              class="github-link"
              href={githubLink.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={githubLink.label}
            >
              <BrandIcon name="Github" size={17} />
            </a>
          )}
          <ReadingModeToggle />
          <ThemeToggle />
          <details class="mobile-menu">
            <summary aria-label="Ouvrir le menu">
              <>
                <Menu class="menu-open" size={19} />
                <X class="menu-close" size={19} />
              </>
            </summary>
            <button type="button" class="mobile-backdrop" aria-label="Fermer le menu" />
            <div class="mobile-panel">
              <p>
                <span aria-hidden="true">$</span> cd ~/navigation
              </p>
              <nav aria-label="Navigation mobile">
                {navItems.map((item, index) => {
                  const href = item.url || item.route;
                  const isActive = active(item);
                  return (
                    <a
                      href={href}
                      class:list={{ active: isActive }}
                      aria-current={isActive ? 'page' : undefined}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener noreferrer' : undefined}
                    >
                      <small>0{index + 1}</small>
                      <span>/{item.label}</span>
                      {item.external ? (
                        <ExternalLink size={14} />
                      ) : (
                        <span aria-hidden="true">↗</span>
                      )}
                    </a>
                  );
                })}
              </nav>
              <div class="mobile-socials">
                {socialLinks.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>
  )
}

<style>
  #site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 0.7rem 1rem;
    pointer-events: none;
    transform: none;
  }

  #site-header[data-hide-on-scroll='all'] {
    transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #site-header[data-hide-on-scroll='all'][data-scroll-state='hidden'] {
    transform: translateY(calc(-100% - 0.7rem));
  }

  #site-header:has(.mobile-menu[open]) {
    transform: none !important;
    transition: none;
  }

  .header-shell {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(1180px, 100%);
    min-height: 52px;
    margin: 0 auto;
    padding: 0.35rem 0.45rem 0.35rem 0.7rem;
    background: color-mix(in srgb, var(--glass-bg-strong) 90%, transparent);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    box-shadow:
      0 12px 40px -22px rgba(0, 0, 0, 0.7),
      inset 0 1px var(--glint);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
    pointer-events: auto;
  }

  .skip-link {
    position: fixed;
    top: -5rem;
    left: 1rem;
    z-index: 200;
    padding: 0.7rem 1rem;
    color: var(--bg-0);
    background: var(--accent-blue);
    border-radius: 8px;
    font: 700 0.78rem var(--font-code);
    transition: top 0.15s ease;
    pointer-events: auto;
  }
  .skip-link:focus {
    top: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    justify-self: start;
    color: var(--text-primary);
    font: 700 0.8rem var(--font-code);
    text-decoration: none;
  }
  .brand-glyph {
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;
    margin-right: 0.18rem;
    color: var(--bg-0);
    background: var(--accent-amber);
    border-radius: 7px;
  }
  .brand-host {
    color: var(--text-muted);
    font-weight: 450;
  }
  .brand:hover .brand-host {
    color: var(--accent-blue);
  }

  .desktop-nav {
    display: flex;
    gap: 0.15rem;
    justify-self: center;
  }
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.12rem;
    min-height: 38px;
    padding: 0.5rem 0.72rem;
    color: var(--text-muted);
    border: 1px solid transparent;
    border-radius: 8px;
    font: 550 0.72rem var(--font-code);
    text-decoration: none;
  }
  .nav-item > span {
    color: var(--text-muted);
    opacity: 0.6;
  }
  .nav-item:hover {
    color: var(--text-primary);
    background: rgba(var(--blue-rgb), 0.07);
  }
  .nav-item.active {
    color: var(--text-primary);
    background: var(--glass-bg-strong);
    border-color: var(--glass-border);
    box-shadow: inset 0 -2px var(--accent-amber);
  }
  .nav-item.active > span {
    color: var(--accent-amber);
    opacity: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.1rem;
  }
  .github-link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--text-muted);
    border-radius: 8px;
  }
  .github-link:hover {
    color: var(--text-primary);
    background: var(--glass-bg);
  }
  .mobile-menu {
    display: none;
    position: relative;
  }
  .mobile-menu summary {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--text-primary);
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary:hover {
    background: var(--glass-bg);
  }
  .mobile-menu[open] summary {
    background: var(--bg-1);
    box-shadow: inset 0 0 0 1px var(--glass-border);
  }
  .menu-close {
    display: none;
  }
  .mobile-menu[open] .menu-open {
    display: none;
  }
  .mobile-menu[open] .menu-close {
    display: block;
  }
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: light-dark(rgba(31, 26, 18, 0.42), rgba(5, 8, 12, 0.76));
    cursor: default;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .mobile-menu[open] .mobile-backdrop {
    display: block;
  }
  .mobile-panel {
    position: fixed;
    top: 4.25rem;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom));
    color: var(--text-primary);
    background: var(--bg-1);
    border: 1px solid var(--glass-border);
    border-radius: 18px;
    box-shadow:
      0 24px 80px -28px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 var(--glint);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-panel > p {
    margin: 0 0 0.8rem;
    color: var(--text-muted);
    font: 0.7rem var(--font-code);
  }
  .mobile-panel > p span {
    color: var(--accent-teal);
  }
  .mobile-panel nav {
    display: grid;
    gap: 0.35rem;
  }
  .mobile-panel nav a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    min-height: 56px;
    padding: 0.7rem 0.85rem;
    color: var(--text-secondary);
    border: 1px solid transparent;
    border-radius: 12px;
    font: 0.88rem var(--font-code);
    text-decoration: none;
  }
  .mobile-panel nav a small {
    color: var(--text-muted);
    font-size: 0.64rem;
  }
  .mobile-panel nav a.active {
    color: var(--text-primary);
    border-color: rgba(var(--amber-rgb), 0.35);
    background: rgba(var(--amber-rgb), 0.08);
  }
  .mobile-panel nav a.active small {
    color: var(--accent-amber);
  }
  .mobile-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--glass-border);
  }
  .mobile-socials a {
    color: var(--text-muted);
    font: 0.72rem var(--font-code);
    text-underline-offset: 3px;
  }

  @media (max-width: 820px) {
    #site-header[data-hide-on-scroll='mobile'] {
      transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #site-header[data-hide-on-scroll='mobile'][data-scroll-state='hidden'] {
      transform: translateY(calc(-100% - 0.7rem));
    }
    #site-header {
      padding: 0.5rem 0.6rem;
    }
    .header-shell {
      grid-template-columns: 1fr auto;
    }
    .desktop-nav,
    .github-link {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .brand-host {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .header-shell {
      padding-left: 0.45rem;
    }
    .brand > span:not(.brand-glyph) {
      display: none;
    }
    .mobile-panel {
      left: 0.45rem;
      right: 0.45rem;
      top: 4rem;
    }
    .mobile-panel nav a {
      min-height: 54px;
      padding-inline: 0.75rem;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .header-shell {
      background: var(--bg-1);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .mobile-backdrop {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header[data-hide-on-scroll] {
      transition: none;
    }
  }

  :global(body.mobile-menu-open) {
    overflow: hidden;
  }
</style>

<script>
  let mobileMenuController: AbortController | undefined;
  let scrollController: AbortController | undefined;

  const HIDE_BREAKPOINT = 820;
  const SCROLL_DELTA = 8;
  const ALWAYS_VISIBLE = 64;

  function initHeaderScroll() {
    scrollController?.abort();
    const candidate = document.getElementById('site-header');
    if (!candidate) return;
    const header = candidate;
    const mode = header.dataset.hideOnScroll;
    if (!mode) return;

    const controller = new AbortController();
    scrollController = controller;
    const { signal } = controller;
    const compact = window.matchMedia(`(max-width: ${HIDE_BREAKPOINT}px)`);
    const menu = header.querySelector<HTMLDetailsElement>('.mobile-menu');
    let lastY = window.scrollY;
    let ticking = false;
    let listening = false;

    const show = () => (header.dataset.scrollState = 'visible');
    const hide = () => (header.dataset.scrollState = 'hidden');

    function update() {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const delta = y - lastY;
      if (
        y <= ALWAYS_VISIBLE ||
        menu?.open ||
        header.contains(document.activeElement) ||
        y + window.innerHeight >= document.documentElement.scrollHeight - 2
      ) {
        lastY = y;
        show();
        return;
      }
      if (Math.abs(delta) < SCROLL_DELTA) return;
      if (delta > 0) hide();
      else show();
      lastY = y;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    function apply() {
      const enabled = mode === 'all' || compact.matches;
      if (!enabled) {
        show();
        if (listening) window.removeEventListener('scroll', onScroll);
        listening = false;
        return;
      }
      lastY = Math.max(0, window.scrollY);
      update();
      if (!listening) {
        window.addEventListener('scroll', onScroll, { passive: true, signal });
        listening = true;
      }
    }

    compact.addEventListener('change', apply, { signal });
    header.addEventListener('focusin', show, { signal });
    menu?.addEventListener('toggle', show, { signal });
    apply();

    const observer = new ResizeObserver(() => {
      const height = Math.ceil(header.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--header-height', `${height}px`);
    });
    observer.observe(header);
    signal.addEventListener('abort', () => observer.disconnect());
  }

  function initMobileMenu() {
    mobileMenuController?.abort();
    const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    if (!menu) return;

    const controller = new AbortController();
    mobileMenuController = controller;
    const { signal } = controller;
    const summary = menu.querySelector<HTMLElement>('summary');
    const backdrop = menu.querySelector<HTMLButtonElement>('.mobile-backdrop');

    const syncState = () => {
      const open = menu.open;
      document.body.classList.toggle('mobile-menu-open', open);
      summary?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    };
    const close = (restoreFocus = false) => {
      if (!menu.open) return;
      menu.open = false;
      syncState();
      if (restoreFocus) summary?.focus();
    };

    menu.addEventListener('toggle', syncState, { signal });
    backdrop?.addEventListener('click', () => close(true), { signal });
    menu
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => close(), { signal }));
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && menu.open) close(true);
      },
      { signal },
    );
    syncState();
  }
  initMobileMenu();
  initHeaderScroll();
  document.addEventListener('astro:page-load', () => {
    initMobileMenu();
    initHeaderScroll();
  });
  document.addEventListener('astro:after-swap', () => {
    document.getElementById('site-header')?.setAttribute('data-scroll-state', 'visible');
  });
  document.addEventListener('astro:before-swap', () =>
    document.body.classList.remove('mobile-menu-open'),
  );
</script>
