---
import { fr } from '../i18n';
import { readingModeScript } from '../scripts/inline-scripts';
import type { ChromeLabels } from '../types';

interface Props {
  labels?: Pick<ChromeLabels, 'readingModeOn' | 'readingModeOff'>;
}

const { labels = fr } = Astro.props;
---

<button
  id="reading-mode-toggle"
  type="button"
  aria-pressed="false"
  aria-label={labels.readingModeOn}
  class="reading-mode-toggle"
  title={labels.readingModeOn}
  data-label-on={labels.readingModeOn}
  data-label-off={labels.readingModeOff}
>
  <span aria-hidden="true">Aa</span>
</button>

<style>
  .reading-mode-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: none;
    color: var(--muted-text);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }

  .reading-mode-toggle:hover,
  .reading-mode-toggle[aria-pressed='true'] {
    color: var(--accent-blue);
    border-color: rgba(var(--blue-rgb), 0.45);
    background: rgba(var(--blue-rgb), 0.12);
  }

  .reading-mode-toggle[aria-pressed='true'] {
    font-family: var(--font-reading);
  }

  .reading-mode-toggle:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
</style>

<script is:inline set:html={readingModeScript} />
