---
import {
  readingModeScript,
  themeBootstrapScript,
  themeToggleScript,
} from '../scripts/inline-scripts.js';
import { sha256CspHash } from '../utils/csp.js';

interface Props {
  /** Enable only when the consumer has configured Astro native CSP. */
  csp?: boolean;
}

const { csp = false } = Astro.props;
if (csp) {
  for (const source of [themeBootstrapScript, themeToggleScript, readingModeScript]) {
    Astro.csp?.insertScriptHash(await sha256CspHash(source));
  }
}
---

<script is:inline set:html={themeBootstrapScript} />
