---
import { fr } from '../i18n';
import type { ChromeLabels } from '../types';

interface Props {
  labels?: Pick<ChromeLabels, 'themeToLight' | 'themeToDark'>;
}

const { labels = fr } = Astro.props;
---

<!-- aria-pressed reflète l'état sombre (§5.2) ; le libellé accessible est
     mis à jour par le script pour annoncer l'action, pas seulement l'icône. -->
<button
  id="theme-toggle"
  type="button"
  aria-pressed="false"
  aria-label={labels.themeToDark}
  class="theme-toggle"
  title={labels.themeToDark}
  data-label-light={labels.themeToLight}
  data-label-dark={labels.themeToDark}
>
  <!-- Icônes en traits (§3.5) : stroke=currentColor, 1.7, bouts arrondis —
       cohérent avec les capsules arrondies du reste du système. -->
  <svg
    id="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    class="icon"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path
      d="M12 1.8v2.4M12 19.8v2.4M1.8 12h2.4M19.8 12h2.4M4.8 4.8l1.7 1.7M17.5 17.5l1.7 1.7M19.2 4.8l-1.7 1.7M6.5 17.5l-1.7 1.7"
    ></path>
  </svg>
  <svg
    id="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    class="icon hidden"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    background: none;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--muted-text);
    transition: color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .icon {
    display: block;
    width: 18px;
    height: 18px;
    /* Traits, pas de remplissage plein (§3.5) */
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .hidden {
    display: none !important;
  }
</style>

<script is:inline>
  (function () {
    // Le stockage peut lever (mode privé, cookies bloqués) : on retombe
    // silencieusement sur la préférence système (§5.3).
    function readStored() {
      try {
        return localStorage.getItem('theme');
      } catch (e) {
        return null;
      }
    }
    function writeStored(theme) {
      try {
        localStorage.setItem('theme', theme);
      } catch (e) {
        /* sans effet */
      }
    }

    // applyTheme n'ÉCRIT jamais : sans cette séparation, le thème déduit du
    // système serait persisté dès le premier chargement et l'écoute des
    // changements système ne se déclencherait plus jamais (§5.4).
    function applyTheme(theme) {
      var sun = document.getElementById('sun-icon');
      var moon = document.getElementById('moon-icon');
      var toggle = document.getElementById('theme-toggle');
      var isDark = theme === 'dark';

      // data-theme pilote color-scheme : les tokens light-dark() de
      // global.css basculent instantanément, sans couleur codée en dur.
      document.documentElement.dataset.theme = theme;
      document.documentElement.classList.toggle('dark', isDark);
      sun && sun.classList.toggle('hidden', isDark);
      moon && moon.classList.toggle('hidden', !isDark);

      if (toggle) {
        toggle.setAttribute('aria-pressed', String(isDark));
        var label = isDark ? toggle.dataset.labelLight : toggle.dataset.labelDark;
        toggle.setAttribute('aria-label', label);
        toggle.setAttribute('title', label);
      }
    }

    function currentTheme() {
      var stored = readStored();
      if (stored === 'light' || stored === 'dark') return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function initToggle() {
      applyTheme(currentTheme());

      // Re-bind toggle (DOM may be new after View Transition)
      var toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.onclick = function () {
          var next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
          applyTheme(next);
          writeStored(next); // choix explicite : lui seul est mémorisé
        };
      }
    }

    initToggle();
    document.addEventListener('astro:page-load', initToggle);

    // Suit le système tant qu'aucun choix explicite n'a été fait — un choix
    // explicite n'est jamais écrasé par un changement système (§5.4).
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      if (!readStored()) applyTheme(e.matches ? 'dark' : 'light');
    });
  })();
</script>
