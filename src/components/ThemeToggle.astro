---
import { fr } from '../i18n.js';
import { themeToggleScript } from '../scripts/inline-scripts.js';
import type { ChromeLabels } from '../types.js';

interface Props {
  labels?: Pick<ChromeLabels, 'themeToLight' | 'themeToDark'>;
}

const { labels = fr } = Astro.props;
---

<!-- aria-pressed reflects the dark state (§5.2); the script updates the
     accessible label to announce the action rather than only the icon. -->
<button
  id="theme-toggle"
  type="button"
  aria-pressed="false"
  aria-label={labels.themeToDark}
  class="theme-toggle"
  title={labels.themeToDark}
  data-label-light={labels.themeToLight}
  data-label-dark={labels.themeToDark}
>
  <!-- Outline icons (§3.5): stroke=currentColor, 1.7, rounded caps —
       consistent with the rounded capsules used elsewhere in the system. -->
  <svg
    id="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    class="icon"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path
      d="M12 1.8v2.4M12 19.8v2.4M1.8 12h2.4M19.8 12h2.4M4.8 4.8l1.7 1.7M17.5 17.5l1.7 1.7M19.2 4.8l-1.7 1.7M6.5 17.5l-1.7 1.7"
    ></path>
  </svg>
  <svg
    id="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    class="icon hidden"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    background: none;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--muted-text);
    transition: color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .icon {
    display: block;
    width: 18px;
    height: 18px;
    /* Outlines, not solid fills (§3.5). */
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .hidden {
    display: none !important;
  }
</style>

<script is:inline set:html={themeToggleScript} />
